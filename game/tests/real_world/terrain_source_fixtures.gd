# Tiny authored classic TIFF index bodies advertise full-resolution source data.
# All 1296 block pointers intentionally share one mocked compressed source block.
static func _wc_uint(body: PackedByteArray, at: int, value: int, size: int, little: bool) -> void:
 for i in size: body[at+i]=(value>>(8*(i if little else size-1-i)))&255

static func _wc_double(body: PackedByteArray, at: int, value: float, little: bool) -> void:
 var bytes := PackedByteArray()
 bytes.resize(8)
 bytes.encode_double(0,value)
 for i in 8: body[at+i]=bytes[i if little else 7-i]

static func worldcover_tiff(little: bool = true, overrides: Dictionary = {}) -> Dictionary:
 var block := worldcover_block()
 var block_offset := int(overrides.get("block_offset",100000))
 var tags := {
  256:[4,1,overrides.get("width",36000)],257:[4,1,36000],258:[3,1,8],
  259:[3,1,overrides.get("compression",8)],262:[3,1,3],
  322:[4,1,overrides.get("block_width",1024)],323:[4,1,1024],
  324:[4,1296,20000],325:[4,1296,26000],320:[3,768,1024],
  33550:[12,3,3000],33922:[12,6,3040],34735:[3,16,3100]
 }
 if overrides.get("explicit_defaults",false):
  tags[277]=[3,1,1]
  tags[317]=[3,1,1]
  tags[339]=[3,1,1]
 for tag in overrides.get("tags",{}): tags[tag]=overrides.tags[tag]
 var keys := tags.keys()
 keys.sort()
 var body := PackedByteArray()
 body.resize(32000)
 body[0]=73 if little else 77
 body[1]=body[0]
 _wc_uint(body,2,overrides.get("magic",42),2,little)
 _wc_uint(body,4,8,4,little)
 _wc_uint(body,8,keys.size(),2,little)
 var tag_entries := {}
 for i in keys.size():
  var tag: int = keys[i]
  var entry: Array = tags[tag]
  var at := 10+i*12
  tag_entries[tag]=at
  _wc_uint(body,at,tag,2,little)
  _wc_uint(body,at+2,entry[0],2,little)
  _wc_uint(body,at+4,entry[1],4,little)
  _wc_uint(body,at+8,entry[2],2 if entry[0]==3 and entry[1]==1 else 4,little)
 # Deliberately different colors: class 80 is red=1234, not palette index 80.
 for i in 768: _wc_uint(body,1024+i*2,1234 if i==80 else 4321,2,little)
 for i in 1296:
  _wc_uint(body,20000+i*4,block_offset,4,little)
  _wc_uint(body,26000+i*4,overrides.get("block_count",block.size()),4,little)
 for i in 3: _wc_double(body,3000+i*8,overrides.get("scale",1.0/12000.0) if i<2 else 0.0,little)
 var tie := [0.0,0.0,0.0,-117.0,39.0,0.0]
 if overrides.has("tie"): tie=overrides.tie
 for i in 6: _wc_double(body,3040+i*8,tie[i],little)
 var geo := [1,1,0,3,1024,0,1,2,1025,0,1,1,2048,0,1,overrides.get("epsg",4326)]
 for i in geo.size(): _wc_uint(body,3100+i*2,geo[i],2,little)
 return {"body":body,"block":block,"object_size":block_offset+int(overrides.get("block_count",block.size())),"tags":tag_entries,"little":little}

static func worldcover_block(kind: String = "normal") -> PackedByteArray:
 var fixtures := {
  "normal":"",
  "oversized":"",
  "short":"",
 }
 return String(fixtures[kind]).hex_decode()

# Numeric conversion fixtures contain no downloaded bytes or live source requests.
static func conversion_packet(kind: String) -> Dictionary:
 var result:=packet()
 if kind=="corner_spike":
  result.vertex_metres.fill(0.0)
  result.vertex_metres[0]=900.0
 elif kind=="provenance":
  result.source_objects=[]
  for descriptor in result.sources:
   result.source_objects.append({"descriptor":descriptor.duplicate(),"etag":"\"authored-object\"","size":4096,"ranges":[{"offset":214,"length":512,"sha256":"a".repeat(64)}]})
 return result
