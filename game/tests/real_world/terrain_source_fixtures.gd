extends RefCounted
static func selection(overrides: Dictionary = {}) -> Dictionary:
 var result: Dictionary = TerrainImportContract.defaults().selection
 result.merge(overrides,true)
 return result
static func controls(overrides: Dictionary = {}) -> Dictionary:
 var result: Dictionary = TerrainImportContract.defaults().controls
 result.merge(overrides,true)
 return result
static func metadata() -> Dictionary:
 return {"name":"Real terrain fixture","difficulty":1,"founded_year":1900}
static func packet(kind: String = "flat_dry") -> Dictionary:
 var vertices := PackedFloat64Array()
 vertices.resize(16641)
 vertices.fill(-12.0 if kind == "negative_dry" else 100.0)
 var centers := PackedFloat64Array()
 centers.resize(16384)
 centers.fill(-12.0 if kind == "negative_dry" else 100.0)
 var water := PackedByteArray()
 water.resize(16384)
 water.fill(64 if kind == "flat_wet" else 0)
 return {"selection":selection(),"vertex_metres":vertices,"center_metres":centers,"water_counts":water,"sources":[{"source":"terrarium","z":10,"x":184,"y":401},{"source":"worldcover","tile":"N36W117"}],"acquired_utc":"2026-10-05T00:00:00Z"}

# Numeric fixtures use raw bytes, never floating point colors or textures.
static func terrarium_png(rgb: Vector3i, alpha: int = 255) -> PackedByteArray:
 var bytes := PackedByteArray()
 bytes.resize(256*256*4)
 for pixel in 256*256:
  bytes[pixel*4]=rgb.x
  bytes[pixel*4+1]=rgb.y
  bytes[pixel*4+2]=rgb.z
  bytes[pixel*4+3]=alpha
 return Image.create_from_data(256,256,false,Image.FORMAT_RGBA8,bytes).save_png_to_buffer()

static func terrarium_seam(dateline: bool = false) -> Dictionary:
 var first_x := 3 if dateline else 1
 var next_x := 0 if dateline else 2
 return {
  "2/%d/1"%first_x:terrarium_png(Vector3i(128,10,0)),
  "2/%d/1"%next_x:terrarium_png(Vector3i(128,20,0)),
  "2/%d/2"%first_x:terrarium_png(Vector3i(128,30,0)),
  "2/%d/2"%next_x:terrarium_png(Vector3i(128,40,0)),
 }

