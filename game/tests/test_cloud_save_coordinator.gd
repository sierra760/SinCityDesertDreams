func test_upload_metadata_matches_pinned_payload_not_newer_checkpoint() -> void:
	var root := _root()
	var store := _store(root)
	var work := store.stage(store.create_slot(), _city(root, "Exact sent title"))
	var fake := Fake.new()
	var header := store.readable_header(work.continuation.path)
	check(not header.is_empty(), "pinned header must validate")
	var coordinator := _ready(store, fake)
	check(not store.readable_header(work.continuation.path).is_empty(), "reopened pinned header must validate")
	check(not coordinator._save_metadata(work).is_empty(), "pinned upload metadata must validate")
	var send: Dictionary = fake.last("save")
	check(not send.is_empty(), "metadata must allow dispatch")
	if send.is_empty():
		coordinator.shutdown()
		return
	var args: Dictionary = send.args
	check(args.get("metadata") is Dictionary)
	if args.get("metadata") is Dictionary:
		check_eq(args.metadata.name, "Exact sent title")
		check_eq(args.metadata.schema_version, 1)
		check(args.metadata.source_device is String)
		check(not args.metadata.has("path"))
	check_eq(args.pending.continuation.bytes, work.continuation.bytes)
	store.stage(work.slot_id, _city(root, "Newer title"))
	check_eq(fake.last("save").args.pending.commit_id, work.commit_id)
	coordinator.shutdown()

func test_hidden_library_does_not_poll_and_deletion_notifies_loaded_session() -> void:
