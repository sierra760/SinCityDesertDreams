func test_account_change_revokes_inflight_upload_before_ordinary_completion() -> void:
	var root := _root()
	var store := _store(root)
	var work := store.stage(store.create_slot(), _city(root))
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	_finish_initial(coordinator, fake)
	var sent := fake.last("save")
	var owners: Array = []
	coordinator.verified_owner_changed.connect(func(old: String, current: String, epoch: int) -> void: owners.append([old, current, epoch]))
	fake.finish(sent, {"commit_id": work.commit_id, "change_tag": "old-tag", "system_fields": PackedByteArray([2])})
	fake.account_changed(sent.epoch)
	coordinator.advance(1)
	check_eq(owners.size(), 1)
	check_eq(owners[0][0], "account-a")
	check_eq(owners[0][1], "")
	check_eq(_store(root).inflight().size(), 1, "untrusted old completion cannot clear durable send")
	fake.finish(fake.last("account"), {}, "unavailable")
	coordinator.advance(2)
	coordinator.advance(1002)
	check_eq(fake.count("save"), 1, "unverified account cannot upload parked work")
	coordinator.shutdown()

func test_divergence_forks_before_retiring_and_publishes_both_branches() -> void:
	var root := _root()
	var store := _store(root)
	var local := _city(root, "Local")
	var remote_path := _city(root, "Remote")
	var first := store.stage(store.create_slot(local), local, local)
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	_finish_initial(coordinator, fake)
	store.stage(first.slot_id, _city(root, "Newest"))
	var fork_ids: Array = []
	coordinator.slot_forked.connect(func(old: String, fresh: String) -> void: fork_ids.append([old, fresh]))
	var remote := _remote(remote_path, first.slot_id)
	fake.finish(fake.last("save"), {"remote": remote}, "conflict")
	coordinator.advance(1)
	check_eq(fork_ids.size(), 1)
	check_eq(store.inflight().size(), 1, "new branch may send after rejected pin retired")
	check_eq(store.pending().size(), 1)
	check_ne(store.pending()[0].slot_id, first.slot_id)
	fake.finish(fake.last("download"), {"downloaded": {"continuation": remote_path}})
	coordinator.advance(2)
	var rows := coordinator.library_entries([])
	check_eq(rows.size(), 2)
	check_eq(store.slots().size(), 2)
	var remote_found := false
	for row in rows:
		if row.slot_id == first.slot_id:
			remote_found = true
			check_eq(row.continuation_sha256, FileAccess.get_sha256(remote_path))
	check(remote_found)
	coordinator.shutdown()

