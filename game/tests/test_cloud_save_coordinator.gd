	var store := _store(root)
	var path := _city(root)
	var remote := _remote(path)
	store.publish_remote(remote, {"continuation": path})
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	check(coordinator.has_signal("slot_removed"))
	var removed: Array = []
	if coordinator.has_signal("slot_removed"):
		coordinator.connect("slot_removed", func(id: String) -> void: removed.append(id))
	_page(fake, [], PackedByteArray([5]), false, [remote.slot_id])
	coordinator.advance(1)
	check_eq(removed.size(), 0, "inventory waits for authoritative removal revalidation")
	fake.finish(fake.last("fetch_record"), {"remote": {}})
	coordinator.advance(2)
	check_eq(removed, ["remote-slot"])
	coordinator.advance(30000)
	check_eq(fake.count("changes"), 1, "hidden library does not poll")
	coordinator.refresh(&"visible")
	coordinator.advance(30001)
	check_eq(fake.count("changes"), 2)
	_page(fake)
	coordinator.advance(30002)
	coordinator.refresh(&"hidden")
	coordinator.advance(60002)
	check_eq(fake.count("changes"), 2)
	coordinator.shutdown()

