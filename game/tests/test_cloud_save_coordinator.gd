extends "res://tests/test_case.gd"
const Fake = preload("res://tests/helpers/fake_apple_cloud.gd")
class FailingStore extends CloudSaveStore:
	var fail_write := false
	func _write_journal(bytes: PackedByteArray) -> Error:
		return ERR_FILE_CANT_WRITE if fail_write else super._write_journal(bytes)
var _roots: Array[String] = []
func _root() -> String:
	var path := "user://cloud-coordinator-tests/%d-%d" % [Time.get_ticks_usec(), _roots.size()]
	_roots.append(path)
	DirAccess.make_dir_recursive_absolute(path)
	return path
func _store(root: String) -> CloudSaveStore:
	var store := CloudSaveStore.new(root.path_join("store"))
	check_eq(store.open_library("account-a"), OK)
	return store
func _city(root: String, title: String = "City") -> String:
	var path := root.path_join(title + ".sc2d")
	var city := flat_city()
	city.name = title
	check_eq(SaveFormat.save(path, city), OK)
	return path
func _remote(path: String, id: String = "remote-slot") -> Dictionary:
	return {"slot_id": id, "commit_id": "remote-commit", "change_tag": "tag-1",
		"system_fields": PackedByteArray([1]), "continuation_sha256": FileAccess.get_sha256(path),
		"manual_sha256": "", "tombstone": false, "metadata": {"name": "Remote"}}
func _ready(store: CloudSaveStore, fake: RefCounted) -> CloudSaveCoordinator:
	var coordinator := CloudSaveCoordinator.new(store, fake)
	coordinator.jitter = func() -> float: return 0.0
	coordinator.set_enabled(true)
	coordinator.advance(0)
	fake.finish(fake.last("account"), {"owner": "account-a"})
	coordinator.advance(0)
	fake.finish(fake.last("prepare_zone"))
	coordinator.advance(0)
	return coordinator
func _page(fake: RefCounted, records: Array = [], token: PackedByteArray = PackedByteArray([9]), more: bool = false, deleted: Array = []) -> void:
	fake.finish(fake.last("changes"), {"records": records, "deleted_ids": deleted, "token": token, "more": more})
func _finish_initial(coordinator: CloudSaveCoordinator, fake: RefCounted) -> void:
	_page(fake)
	coordinator.advance(0)
func after_all() -> void:
	for root in _roots: _remove_tree(root)
func _remove_tree(path: String) -> void:
	var dir := DirAccess.open(path)
	if dir == null: return
	for child in dir.get_directories(): _remove_tree(path.path_join(child))
	for child in dir.get_files(): DirAccess.remove_absolute(path.path_join(child))
	DirAccess.remove_absolute(path)

func test_offline_restart_retries_durable_queue() -> void:
	var root := _root()
	var store := _store(root)
	store.stage(store.create_slot(), _city(root))
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	_finish_initial(coordinator, fake)
	check_eq(fake.count("save"), 1)
	fake.finish(fake.last("save"), {}, "transient")
	coordinator.advance(10)
	coordinator.shutdown()
	var reopened := _store(root)
	var retry := Fake.new()
	var resumed := _ready(reopened, retry)
	check_eq(retry.count("fetch_record"), 1, "recovered uncertain pin is fetched before replay")
	check_eq(retry.count("save"), 0)
	resumed.shutdown()

