func test_restart_after_durable_fork_recovers_unpublished_server_branch() -> void:
	for tombstone in [false, true]:
		var root := _root()
		var store := _store(root)
		var path := _city(root, "Original")
		var work := store.stage(store.create_slot(), "" if tombstone else path, "", tombstone)
		store.begin_upload(work.slot_id, work.generation)
		var branch := store.fork_pending(work.slot_id, work.generation)
		check_ne(branch, "")
		store.retire_upload(work.slot_id, work.generation)
		var reopened := _store(root)
		var fake := Fake.new()
		var coordinator := _ready(reopened, fake)
		var fetch := fake.last("fetch_record")
		check(not fetch.is_empty(), "fork's original identity must fetch even without recovered pins")
		if fetch.is_empty():
			coordinator.shutdown()
			continue
		check_eq(fetch.args.slot_id, work.slot_id)
		var remote_path := _city(root, "Server preserved")
		fake.finish(fetch, {"remote": _remote(remote_path, work.slot_id)})
		coordinator.advance(1)
		var download := fake.last("download")
		check(not download.is_empty())
		if not download.is_empty():
			fake.finish(download, {"downloaded": {"continuation": remote_path}})
			coordinator.advance(2)
		var found := false
		for row in reopened.slots():
			if row.slot_id == work.slot_id: found = row.continuation_sha256 == FileAccess.get_sha256(remote_path)
		check(found)
		coordinator.shutdown()

