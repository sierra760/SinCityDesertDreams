func _stale_removal_after_ack(tombstone: bool) -> void:
	var root := _root()
	var store := _store(root)
	var path := _city(root, "Restored continuation")
	var id := "recreated-slot"
	var older := _remote(path, id)
	older.tombstone = true
	older.continuation_sha256 = ""
	older.commit_id = "older-tombstone"
	older.change_tag = "older-tag"
	if tombstone: check_eq(store.publish_remote(older, {}), OK)
	else: id = store.create_slot()
	var work := store.stage(id, path)
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	var removed: Array = []
	var forks: Array = []
	coordinator.slot_removed.connect(func(slot: String) -> void: removed.append(slot))
	coordinator.slot_forked.connect(func(old: String, fresh: String) -> void: forks.append([old, fresh]))
	if tombstone: _page(fake, [older], PackedByteArray([31]))
	else: _page(fake, [], PackedByteArray([32]), false, [id])
	coordinator.advance(1)
	check_eq(store.change_token(), PackedByteArray())
	fake.finish(fake.last("save"), {"commit_id": work.commit_id, "change_tag": "newer-ack", "system_fields": PackedByteArray([8])})
	coordinator.advance(2)
	check(FileAccess.file_exists(work.continuation.path), "older inventory must not prune the acknowledged continuation")
	check_eq(removed.size(), 0)
	check_eq(store.change_token(), PackedByteArray(), "cursor waits for current server identity")
	var fetch := fake.last("fetch_record")
	check(not fetch.is_empty(), "direct removal must revalidate actual record after acknowledgement")
	if fetch.is_empty():
		coordinator.shutdown()
		return
	check_eq(fetch.args.slot_id, id)
	var actual := _remote(path, id)
	actual.commit_id = work.commit_id
	actual.change_tag = "newer-ack"
	actual.system_fields = PackedByteArray([8])
	fake.finish(fetch, {"remote": actual})
	coordinator.advance(3)
	check_eq(store.slots().size(), 1)
	check_eq(store.pending().size(), 0)
	check_eq(removed.size(), 0)
	check_eq(forks.size(), 0)
	check(FileAccess.file_exists(work.continuation.path))
	var rows := coordinator.library_entries([])
	check_eq(rows.size(), 1)
	if rows.size() == 1:
		check_eq(rows[0].slot_id, id)
		check_eq(rows[0].commit_id, work.commit_id)
		check_eq(FileAccess.get_sha256(rows[0].path), work.continuation.sha256)
	check_eq(store.change_token(), PackedByteArray([31] if tombstone else [32]))
	coordinator.shutdown()

func test_queued_older_tombstone_cannot_remove_acknowledged_restore() -> void:
	_stale_removal_after_ack(true)

func test_queued_deleted_id_cannot_remove_acknowledged_recreation() -> void:
	_stale_removal_after_ack(false)

func test_removal_revalidation_serializes_new_same_slot_local_send() -> void:
	var root := _root()
