func test_backoff_doubles_with_injected_jitter_and_server_deadline() -> void:
	var fake := Fake.new()
	var coordinator := CloudSaveCoordinator.new(_store(_root()), fake)
	coordinator.jitter = func() -> float: return 1.0
	coordinator.set_enabled(true)
	coordinator.advance(0)
	fake.finish(fake.last("account"), {}, "transient")
	coordinator.advance(0)
	check_eq(coordinator.status().retry_at_ms, 1250)
	coordinator.advance(1250)
	fake.finish(fake.last("account"), {}, "transient")
	coordinator.advance(1250)
	check_eq(coordinator.status().retry_at_ms, 3750)
	coordinator.advance(3750)
	fake.finish(fake.last("account"), {}, "quota", 10000)
	coordinator.advance(3750)
	check_eq(coordinator.status().retry_at_ms, 13750)
	coordinator.shutdown()

func test_refresh_coalesces_and_periodic_foreground_refreshes() -> void:
	var fake := Fake.new()
	var coordinator := _ready(_store(_root()), fake)
	coordinator.refresh(&"visible")
	coordinator.refresh(&"visible")
	coordinator.advance(1)
	check_eq(fake.count("changes"), 1)
	_page(fake)
	coordinator.advance(2)
	check_eq(fake.count("changes"), 1, "visible requests coalesce with the current inventory")
	coordinator.refresh(&"hidden")
	coordinator.refresh(&"visible")
	coordinator.advance(29999)
	check_eq(fake.count("changes"), 1, "reopening cannot bypass the 30-second limit")
	coordinator.advance(30000)
	check_eq(fake.count("changes"), 2)
	_page(fake)
	coordinator.advance(30001)
	coordinator.advance(59999)
	check_eq(fake.count("changes"), 2)
	coordinator.advance(60000)
	check_eq(fake.count("changes"), 3)
	coordinator.shutdown()

func test_conflict_during_active_changes_keeps_server_branch_until_downloaded() -> void:
	var root := _root()
	var store := _store(root)
	var work := store.stage(store.create_slot(), _city(root, "Local"))
	var path := _city(root, "Server")
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	# Initial changes is still in flight when conditional save reports conflict.
	fake.finish(fake.last("save"), {"remote": _remote(path, work.slot_id)}, "conflict")
	coordinator.advance(1)
	_page(fake)
	coordinator.advance(2)
	var download := fake.last("download")
	check(not download.is_empty())
	if download.is_empty():
		coordinator.shutdown()
		return
	fake.finish(download, {"downloaded": {"continuation": path}})
	coordinator.advance(3)
	var found := false
	for row in store.slots():
		if row.slot_id == work.slot_id:
			found = row.continuation_sha256 == FileAccess.get_sha256(path)
	check(found, "ordinary changes completion cannot overwrite a queued conflict download")
	coordinator.shutdown()

