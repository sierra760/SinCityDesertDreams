	var metadata: Dictionary = store.call("payload_metadata", work.continuation)
	check_eq(metadata.get("application_save_version"), 1)
	var fake := Fake.new()
	var coordinator := _ready(store, fake)
	check_eq(fake.last("save").args.metadata.application_save_version, 1)
	coordinator.shutdown()

