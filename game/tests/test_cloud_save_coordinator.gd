func test_concurrent_lane_failures_preserve_longest_retry_deadline() -> void:
	for server_delay in [60000, 9223372036854775807]:
		var root := _root()
		var store := _store(root)
		var path := _city(root)
		store.stage(store.create_slot(), path)
		var fake := Fake.new()
		var coordinator := _ready(store, fake)
		_page(fake, [_remote(path)])
		coordinator.advance(1)
		check_eq(fake.count("save"), 1)
		check_eq(fake.count("download"), 1)
		var sent := fake.last("save")
		var downloaded := fake.last("download")
		fake.finish(sent, {}, "quota", server_delay)
		fake.finish(downloaded, {}, "transient")
		coordinator.advance(100)
		var deadline: int = 60100 if server_delay == 60000 else 9223372036854775807
		check_eq(coordinator.status().retry_at_ms, deadline)
		var count := fake.requests.size()
		# A duplicate late success cannot clear the outstanding provider deadline.
		fake.finish(downloaded, {"downloaded": {"continuation": path}})
		coordinator.refresh(&"visible")
		coordinator.advance(101)
		coordinator.advance(deadline - 1)
		check_eq(fake.requests.size(), count, "neither lane/control refresh may dispatch before the longest deadline")
		coordinator.advance(deadline)
		check(fake.requests.size() > count)
		coordinator.shutdown()

