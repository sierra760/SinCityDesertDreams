extends "res://tests/test_case.gd"
const F := preload("res://tests/helpers/agricultural_parcel_fixture.gd")

func test_same_parcel_limbs_and_real_hole() -> void:
	var city := flat_city()
	var source := F.active_system(city,F.l_shape(),&"grain")
	var ag: AgricultureSystem = source.ag
	var first := ag.inspect_tile(Vector2i(20,20))
	var other := ag.inspect_tile(Vector2i(20,21))
	check_gt(int(first.get("parcel_id",0)),0)
	check_eq(first.get("parcel_id"),other.get("parcel_id"))
	check_eq(first.get("members_count"),3)
	check_eq(other.get("members_count"),3)
	check_eq(first.get("assigned_jobs"),other.get("assigned_jobs"))
	check_eq(first.get("water_required"),3)
	check_eq(first.get("power_required"),0)
	check_eq(ag.inspect_tile(Vector2i(21,21)),{},"empty bounding corner is not a farm")
	check_eq(MiniMap.tile_color(city,20,20),Zones.COLOR_AGR_LOW)
	check_eq(MiniMap.tile_color(city,21,21),MiniMap.COLOR_EMPTY)
	city.building.put(21,21,Buildings.ROAD_FIRST)
	check_eq(MiniMap.tile_color(city,21,21),MiniMap.COLOR_ROAD)
	source.ctx.systems.clear()

func test_unsafe_prepared_fragment_has_no_productive_counts() -> void:
	var city := flat_city()
	var members := F.mask([[20,20],[21,20],[20,21]])
	F.zone(city,members)
	city.building.put(19,20,Buildings.ROAD_FIRST)
	var value := F.record(1,members,&"cattle_range",&"prepared")
	check_eq(city.agricultural_parcels.put(city,value),OK)
	var source := F.source(city)
	var info: Dictionary = source.ag.inspect_tile(Vector2i(20,20))
	check_eq(info.get("members_count"),3)
	check_eq(info.get("assigned_jobs"),0)
	check_eq(info.get("stock_count"),0)
	check(String(info.get("blocked_reason","")).contains("pasture") or String(info.get("blocked_reason","")).contains("structure"),"unsafe fragment explains its animal-clearance restriction")
	source.ctx.systems.clear()

func test_inspector_consumes_canonical_area_without_filling_hole() -> void:
	var city := flat_city()
	var members := F.l_shape()
	F.zone(city,members)
	check_eq(city.agricultural_parcels.put(city,F.record(1,members,&"grain",&"prepared")),OK)
	var sim := Simulation.new()
	sim.setup(city,7)
	var first := QueryPanel.describe(city,sim,Vector2i(20,20))
	var other := QueryPanel.describe(city,sim,Vector2i(20,21))
	check_eq(first.get("Parcel kind"),"Field")
	check_eq(first.get("Parcel area"),"3 tiles")
	check_eq(first.get("Agricultural jobs"),0)
	check_eq(other.get("Parcel area"),first.get("Parcel area"))
	check(not QueryPanel.describe(city,sim,Vector2i(21,21)).has("#Agriculture"),"hole has no agriculture rows")
	sim.free()

func test_new_cells_keep_map_and_zero_load_warning_precedence() -> void:
	var city := flat_city()
	var members := F.l_shape()
	F.zone(city,members)
	check_eq(city.agricultural_parcels.put(city,F.record(1,members,&"grain",&"active")),OK)
	for index in members:
		var at := AgriculturalParcels.tile(index)
		check_eq(MiniMap.tile_color(city,at.x,at.y),Zones.COLOR_AGR_LOW)
		city.flags.set_bits(at.x,at.y,TileFlags.CONDUCTS_POWER,true)
	check_eq(MiniMap.tile_color(city,21,21),MiniMap.COLOR_EMPTY)
	city.building.put(21,21,Buildings.ROAD_FIRST)
	check_eq(MiniMap.tile_color(city,21,21),MiniMap.COLOR_ROAD)
	var feedback := CityFeedback3D.new()
	root.add_child(feedback)
	feedback.bind_city(city)
	check_eq(feedback.power_warning_count(),0,"zero-load agricultural cells never show outage bolts")
	feedback.free()

func test_livestock_count_comes_from_safe_canonical_stock() -> void:
	var city := flat_city()
	var source := F.active_system(city,F.square(3),&"cattle_range")
	var owned := city.agricultural_parcels.record(1)
	var layout := AgriculturalParcelGeometry.plan(owned)
	var expected := AgriculturalParcelGeometry.max_safe_stock(owned,layout)
	var info: Dictionary = source.ag.inspect_tile(Vector2i(20,20))
	check_gt(expected,0)
	check_eq(info.get("stock_count"),expected)
	check_eq(info.get("members_count"),9)
	source.ctx.systems.clear()

func test_compact_high_density_retains_nonparcel_identity() -> void:
	var city := flat_city()
	city.stamp_building(20,20,AgricultureParams.building_id(&"greenhouse"),Zones.AGR_HIGH)
	var source := F.source(city)
	var info: Dictionary = source.ag.inspect_tile(Vector2i(20,20))
	check_eq(info.get("parcel_id"),0)
	check_eq(info.get("mode"),&"legacy")
	check_eq(info.get("members_count"),1)
	check_eq(info.get("assigned_jobs"),info.get("jobs"))
	source.ctx.systems.clear()
