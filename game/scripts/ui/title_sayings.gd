## A saying chosen with `rng`, or with the global generator when none is given.
static func pick(rng: RandomNumberGenerator = null) -> String:
	var index := rng.randi_range(0, SAYINGS.size() - 1) if rng else randi() % SAYINGS.size()
	return SAYINGS[index]
