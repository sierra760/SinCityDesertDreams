,72969,73374,73521,73588,73825,73910,73773,71572,63572,63572,63572,66572,69194,70924,72038,72584,72387,64387,64387,64387,64387,63387,62387,65387,68387,70349,71640,72334,72805,64805,67805,59805,59805,59805,59805,62805,65805,68569,70407,71447,63447,63447,63447,63447,62447,65447,68447,70450,71758,72602,72567,72554,64554,64554,64554,67554,69910,71392,72366,73011,73475,72989,64989,64989,64989,64989,63989,62989,65989,68989,68989,71886,73302,74022,74432,74224,74291,74510,74730,74936,74965,75045,75041,74949,74902,74758,74674,74137,74184,74398,74598,74865,74934,75025,75024,74979,74845,74761,74743,74269,74198,74177,74462,74733,74816,74852,74784,74617,74545]},"newspaper_archive":[{"title":"The Desert Dispatch","date":"March 1919","year":1919.0,"month":3.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Commuters Spend Lunch Hour Stuck Near Bonanza Gap","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"approval_vote","headline":"Voters Weigh In; Mayor Sierra Scores 38","body":"The annual approval poll put Mayor Sierra at 38 percent this year. The top complaint, as ever, was whatever residents had waited longest for.\n\nThe mayor's office said the number speaks for itself. Everyone else said it too, meaning different things.","priority":500.0,"filler":false},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Old-Timers Bench Gets New Slat; Old-Timers Suspicious","body":"The bench outside the courthouse has a new slat. Its regular occupants tested it for an afternoon and concluded that it will do, for now.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"High School Team Wins By Forfeit; Other Team Lost In Desert","body":"The visiting team took a wrong turn on the way to Friday's game and was found by a rancher some hours later. The home side has claimed the win and a photograph of the tumbleweed they blame.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"April 1919","year":1919.0,"month":4.0,"day":22.0,"extra":false,"stories":[{"kind":"advisor_need","headline":"Council Told Transport Can't Wait","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"May 1919","year":1919.0,"month":5.0,"day":22.0,"extra":false,"stories":[{"kind":"water_shortage","headline":"Water Shortage Hits Bonanza Gap; Pumps Can't Keep Up","body":"Pumping capacity fell short of demand this month and 1 buildings went without water. Swimming pools are down to a puddle and the car wash is closed.\n\nThe water board recommends more pumps, more pipes, or more rain. Two of those are on the budget.","priority":500.0,"filler":false},{"kind":"water_restored","headline":"Pumps Catch Up; Shortage Ends","body":"The pumps are keeping up again and water service has returned to every building in Bonanza Gap. The car wash reopened to a line around the block.\n\nThe water board reminds residents that the desert has not moved and the next dry spell is on its way.","priority":200.0,"filler":false},{"kind":"","headline":"Fishing Derby Held At Reservoir; Fish Decline To Participate","body":"The fishing derby went ahead despite the fish, who kept to the deep end. The prize for largest catch went to a hat.","priority":0.0,"filler":true},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true},{"kind":"","headline":"Motel Pool Refilled; Children Appear From Nowhere","body":"The motel pool was refilled for the season, and within an hour it held more children than the town has on record. The manager has stopped asking for room numbers.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"June 1919","year":1919.0,"month":6.0,"day":22.0,"extra":false,"stories":[{"kind":"water_shortage","headline":"Water Shortage Hits Bonanza Gap; Pumps Can't Keep Up","body":"Pumping capacity fell short of demand this month and 42 buildings went without water. Swimming pools are down to a puddle and the car wash is closed.\n\nThe water board recommends more pumps, more pipes, or more rain. Two of those are on the budget.","priority":500.0,"filler":false},{"kind":"","headline":"Gas Station Adds Ice Machine; Traffic Jam Follows","body":"The gas station at the edge of town installed an ice machine and immediately caused the largest traffic jam in Bonanza Gap history. Police describe the crowd as orderly and damp.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"Scorpion Found In Boot; Boot Found In Yard","body":"A resident discovered a scorpion in his boot on Monday morning. The boot was last seen traveling at speed across the lawn. Both are recovering.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true},{"kind":"","headline":"Tumbleweed The Size Of A Truck Rolls Through Downtown","body":"A tumbleweed of unusual size crossed downtown on Sunday, paused at a stop sign, and continued east. Witnesses agree it had the right of way.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"July 1919","year":1919.0,"month":7.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"A Quiet Month In Bonanza Gap","body":"By every measure the Dispatch keeps, 1919 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Fishing Derby Held At Reservoir; Fish Decline To Participate","body":"The fishing derby went ahead despite the fish, who kept to the deep end. The prize for largest catch went to a hat.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"August 1919","year":1919.0,"month":8.0,"day":22.0,"extra":false,"stories":[{"kind":"tourism_event_announced","headline":"Mark The Calendar: City Sports Festival Comes In September 1919","body":"Bonanza Gap has announced City Sports Festival for September 1919. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Motel Pool Refilled; Children Appear From Nowhere","body":"The motel pool was refilled for the season, and within an hour it held more children than the town has on record. The manager has stopped asking for room numbers.","priority":0.0,"filler":true},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true},{"kind":"","headline":"Neon Sign Repaired; Now Reads Correctly For First Time In Years","body":"The motel sign that has read MOT L since anyone can remember has been fixed. Longtime residents say it looks wrong.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Casino Opens With Free Peanuts, Paid Everything Else","body":"A new casino opened on the strip with a brass band, a searchlight and a buffet that ran out by nine. Management called the evening a success. Patrons called it Tuesday.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"September 1919","year":1919.0,"month":9.0,"day":22.0,"extra":false,"stories":[{"kind":"water_restored","headline":"Pumps Catch Up; Shortage Ends","body":"The pumps are keeping up again and water service has returned to every building in Bonanza Gap. The car wash reopened to a line around the block.\n\nThe water board reminds residents that the desert has not moved and the next dry spell is on its way.","priority":200.0,"filler":false},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"Water Tower Repainted; Town Name Spelled Right This Time","body":"The water tower received a fresh coat of paint and, after some discussion, the correct spelling of Bonanza Gap. The painter blamed the wind for last time.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"October 1919","year":1919.0,"month":10.0,"day":22.0,"extra":false,"stories":[{"kind":"advisor_need","headline":"Council Told Transport Can't Wait","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Diner Adds Second Fan; Customers Weep With Gratitude","body":"The diner on Main Street has installed a second ceiling fan. Regulars describe the difference as life-changing. The pie is unchanged.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true},{"kind":"","headline":"Swap Meet Trades Same Lamp For Fifth Year Running","body":"A brass lamp changed hands again at the swap meet and is now believed to have lived in every house on the west side. Its current owner intends to keep it, which nobody believes.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"November 1919","year":1919.0,"month":11.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Wind Blows, Sun Sets, Bonanza Gap Carries On","body":"By every measure the Dispatch keeps, 1919 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true},{"kind":"","headline":"Cactus Blooms Overnight; Town Turns Out To Look","body":"The night-blooming cactus outside the library opened at last, and half of Bonanza Gap stood around it in bathrobes. It closed by morning, as is its habit.","priority":0.0,"filler":true},{"kind":"","headline":"Barbershop Quartet Now A Trio; Tenor Moved To The Coast","body":"The town quartet has lost its tenor to a job on the coast. Auditions are open. Applicants are warned that the repertoire is mostly about trains.","priority":0.0,"filler":true},{"kind":"","headline":"Local Man Claims To Have Seen Rain; Others Skeptical","body":"A resident reports seeing rain fall on the north end of town. Nobody else saw it, the ground was dry by the time anyone looked, and the matter has been referred to the weather office.","priority":0.0,"filler":true},{"kind":"","headline":"Swap Meet Trades Same Lamp For Fifth Year Running","body":"A brass lamp changed hands again at the swap meet and is now believed to have lived in every house on the west side. Its current owner intends to keep it, which nobody believes.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"December 1919","year":1919.0,"month":12.0,"day":22.0,"extra":false,"stories":[{"kind":"ordinance_enacted","headline":"Bonanza Gap Adopts Pollution Controls Measure","body":"The council adopted the Pollution Controls ordinance this month after a debate that ran long enough for the coffee to go cold twice. It takes effect at once.\n\nSupporters call it overdue. Opponents call it something else. The clerk calls it filed.","priority":360.0,"filler":false},{"kind":"","headline":"Water Tower Repainted; Town Name Spelled Right This Time","body":"The water tower received a fresh coat of paint and, after some discussion, the correct spelling of Bonanza Gap. The painter blamed the wind for last time.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true},{"kind":"","headline":"Local Man Claims To Have Seen Rain; Others Skeptical","body":"A resident reports seeing rain fall on the north end of town. Nobody else saw it, the ground was dry by the time anyone looked, and the matter has been referred to the weather office.","priority":0.0,"filler":true},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"January 1920","year":1920.0,"month":1.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Bonanza Gap Drivers Learn Every Word Of The Radio Jingle","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"Drive-In Reopens With Double Feature And Single Speaker","body":"The drive-in screened its first films in years to a full lot. The one working speaker was placed in the middle and people parked around it like a campfire.","priority":0.0,"filler":true},{"kind":"","headline":"Giant Fiberglass Cactus Draws Visitors, Confuses Birds","body":"The roadside cactus on the highway into town is now the tallest thing for miles. Motorists stop for photographs and birds stop to be disappointed.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"February 1920","year":1920.0,"month":2.0,"day":22.0,"extra":false,"stories":[{"kind":"ordinance_enacted","headline":"Ordinance Vote: Annual Carnival Carries","body":"The council adopted the Annual Carnival ordinance this month after a debate that ran long enough for the coffee to go cold twice. It takes effect at once.\n\nSupporters call it overdue. Opponents call it something else. The clerk calls it filed.","priority":360.0,"filler":false},{"kind":"","headline":"Bingo Night Moved To Larger Hall After Standing-Room Crowd","body":"Wednesday bingo has outgrown the church basement and will move to the grange hall. The caller has been given a microphone and a warning about volume.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Neon Sign Repaired; Now Reads Correctly For First Time In Years","body":"The motel sign that has read MOT L since anyone can remember has been fixed. Longtime residents say it looks wrong.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"March 1920","year":1920.0,"month":3.0,"day":22.0,"extra":false,"stories":[{"kind":"approval_vote","headline":"Annual Poll: 41 Percent Approve Of Mayor Sierra","body":"The annual approval poll put Mayor Sierra at 41 percent this year. The top complaint, as ever, was whatever residents had waited longest for.\n\nThe mayor's office said the number speaks for itself. Everyone else said it too, meaning different things.","priority":500.0,"filler":false},{"kind":"tourism_event_announced","headline":"Annual Carnival Scheduled For April 1920","body":"Bonanza Gap has announced Annual Carnival for April 1920. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"neighbor_news","headline":"News From Down The Road: Ash Meadows Grows","body":"Word arrived from Ash Meadows, our neighbor down the highway, of growth and ambition over there. Their population and ours now trade back and forth across the line.\n\nRelations remain cordial. Their football team is another matter.","priority":200.0,"filler":false},{"kind":"","headline":"Diner Adds Second Fan; Customers Weep With Gratitude","body":"The diner on Main Street has installed a second ceiling fan. Regulars describe the difference as life-changing. The pie is unchanged.","priority":0.0,"filler":true},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"April 1920","year":1920.0,"month":4.0,"day":22.0,"extra":false,"stories":[{"kind":"water_shortage","headline":"Lawns Brown, Tempers Short As Water Falls Short","body":"Pumping capacity fell short of demand this month and 21 buildings went without water. Swimming pools are down to a puddle and the car wash is closed.\n\nThe water board recommends more pumps, more pipes, or more rain. Two of those are on the budget.","priority":500.0,"filler":false},{"kind":"advisor_need","headline":"Transport: The Word From The Advisors' Office","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Water Tower Repainted; Town Name Spelled Right This Time","body":"The water tower received a fresh coat of paint and, after some discussion, the correct spelling of Bonanza Gap. The painter blamed the wind for last time.","priority":0.0,"filler":true},{"kind":"","headline":"Mayor Sierra Cuts Ribbon; Scissors Also Cut Mayor","body":"The ribbon-cutting at the new bench went ahead with a minor injury to Mayor Sierra, who described the scissors as sharper than expected. The bench is open.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"May 1920","year":1920.0,"month":5.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1920 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"High School Team Wins By Forfeit; Other Team Lost In Desert","body":"The visiting team took a wrong turn on the way to Friday's game and was found by a rancher some hours later. The home side has claimed the win and a photograph of the tumbleweed they blame.","priority":0.0,"filler":true},{"kind":"","headline":"Chili Cook-Off Judge Recovers; Vows To Return","body":"The judge hospitalized after last month's cook-off has recovered and says he will be back next year. His doctor has other views.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Barbershop Quartet Now A Trio; Tenor Moved To The Coast","body":"The town quartet has lost its tenor to a job on the coast. Auditions are open. Applicants are warned that the repertoire is mostly about trains.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"June 1920","year":1920.0,"month":6.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Nothing Much Happened; Residents Relieved","body":"By every measure the Dispatch keeps, 1920 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Barbershop Quartet Now A Trio; Tenor Moved To The Coast","body":"The town quartet has lost its tenor to a job on the coast. Auditions are open. Applicants are warned that the repertoire is mostly about trains.","priority":0.0,"filler":true},{"kind":"","headline":"Old Mine Shaft Fenced Off After Goat Incident","body":"The mine shaft east of town has been fenced after a goat was retrieved from it for the third time. The goat is fine and appears to enjoy the attention.","priority":0.0,"filler":true},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"High School Team Wins By Forfeit; Other Team Lost In Desert","body":"The visiting team took a wrong turn on the way to Friday's game and was found by a rancher some hours later. The home side has claimed the win and a photograph of the tumbleweed they blame.","priority":0.0,"filler":true},{"kind":"","headline":"Neon Sign Repaired; Now Reads Correctly For First Time In Years","body":"The motel sign that has read MOT L since anyone can remember has been fixed. Longtime residents say it looks wrong.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"July 1920","year":1920.0,"month":7.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1920 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true},{"kind":"","headline":"Giant Fiberglass Cactus Draws Visitors, Confuses Birds","body":"The roadside cactus on the highway into town is now the tallest thing for miles. Motorists stop for photographs and birds stop to be disappointed.","priority":0.0,"filler":true},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Drive-In Reopens With Double Feature And Single Speaker","body":"The drive-in screened its first films in years to a full lot. The one working speaker was placed in the middle and people parked around it like a campfire.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"August 1920","year":1920.0,"month":8.0,"day":22.0,"extra":false,"stories":[{"kind":"tourism_event_announced","headline":"Bonanza Gap Books City Sports Festival For September 1920","body":"Bonanza Gap has announced City Sports Festival for September 1920. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Scorpion Found In Boot; Boot Found In Yard","body":"A resident discovered a scorpion in his boot on Monday morning. The boot was last seen traveling at speed across the lawn. Both are recovering.","priority":0.0,"filler":true},{"kind":"","headline":"Cactus Blooms Overnight; Town Turns Out To Look","body":"The night-blooming cactus outside the library opened at last, and half of Bonanza Gap stood around it in bathrobes. It closed by morning, as is its habit.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"September 1920","year":1920.0,"month":9.0,"day":22.0,"extra":false,"stories":[{"kind":"water_shortage","headline":"Taps Run Dry In 92 Buildings","body":"Pumping capacity fell short of demand this month and 92 buildings went without water. Swimming pools are down to a puddle and the car wash is closed.\n\nThe water board recommends more pumps, more pipes, or more rain. Two of those are on the budget.","priority":500.0,"filler":false},{"kind":"economy_shift","headline":"Bank Rate Moves, Ledgers Follow","body":"The national outlook has shifted to Slow Growth, according to the people paid to say such things. Local factories and shops will feel it over the coming months.\n\nThe chamber of commerce urged calm, then quietly checked its savings.","priority":500.0,"filler":false},{"kind":"water_restored","headline":"Water Flows Again In Bonanza Gap","body":"The pumps are keeping up again and water service has returned to every building in Bonanza Gap. The car wash reopened to a line around the block.\n\nThe water board reminds residents that the desert has not moved and the next dry spell is on its way.","priority":200.0,"filler":false},{"kind":"","headline":"Mayor Sierra Cuts Ribbon; Scissors Also Cut Mayor","body":"The ribbon-cutting at the new bench went ahead with a minor injury to Mayor Sierra, who described the scissors as sharper than expected. The bench is open.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Rodeo Weekend Leaves Town Sore But Happy","body":"Rodeo weekend came and went with the usual mix of bruises, dust and sunburn. The bull, which has a name, was declared the winner again.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"October 1920","year":1920.0,"month":10.0,"day":22.0,"extra":false,"stories":[{"kind":"water_restored","headline":"Pumps Catch Up; Shortage Ends","body":"The pumps are keeping up again and water service has returned to every building in Bonanza Gap. The car wash reopened to a line around the block.\n\nThe water board reminds residents that the desert has not moved and the next dry spell is on its way.","priority":200.0,"filler":false},{"kind":"advisor_need","headline":"Power: The Word From The Advisors' Office","body":"The advisors' office delivered its monthly memorandum on Power to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"November 1920","year":1920.0,"month":11.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1920 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Well-Digging Contest Ends In Draw, Mud","body":"The well-digging contest at the fair ended when both teams struck water at the same moment and then each other. No winner was declared, but everyone was clean for once.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"December 1920","year":1920.0,"month":12.0,"day":22.0,"extra":false,"stories":[{"kind":"exodus","headline":"Residents Leave Bonanza Gap In Droves","body":"Some 165 families left Bonanza Gap this month, citing everything from taxes to traffic to the smell downwind of the plant. The moving companies are the one growth industry.\n\nMayor Sierra says the city will bounce back. The people leaving say the same thing about wherever they are going.","priority":500.0,"filler":false},{"kind":"abandonment_wave","headline":"For-Sale Signs Bleach In The Sun At Bonanza Gap","body":"Another 45 buildings around Bonanza Gap were left empty this month. Owners cite a mix of taxes, traffic, crime and the general feeling that the grass is greener anywhere with grass.\n\nThe council was asked what it intends to do. Mayor Sierra said the matter was under review, which is what mayors say.","priority":360.0,"filler":false},{"kind":"","headline":"Mayor Sierra Cuts Ribbon; Scissors Also Cut Mayor","body":"The ribbon-cutting at the new bench went ahead with a minor injury to Mayor Sierra, who described the scissors as sharper than expected. The bench is open.","priority":0.0,"filler":true},{"kind":"","headline":"Well-Digging Contest Ends In Draw, Mud","body":"The well-digging contest at the fair ended when both teams struck water at the same moment and then each other. No winner was declared, but everyone was clean for once.","priority":0.0,"filler":true},{"kind":"","headline":"Cactus Blooms Overnight; Town Turns Out To Look","body":"The night-blooming cactus outside the library opened at last, and half of Bonanza Gap stood around it in bathrobes. It closed by morning, as is its habit.","priority":0.0,"filler":true},{"kind":"","headline":"Neon Sign Repaired; Now Reads Correctly For First Time In Years","body":"The motel sign that has read MOT L since anyone can remember has been fixed. Longtime residents say it looks wrong.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"January 1921","year":1921.0,"month":1.0,"day":22.0,"extra":false,"stories":[{"kind":"advisor_need","headline":"Advisors Press Council On Transport","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true},{"kind":"","headline":"Bingo Night Moved To Larger Hall After Standing-Room Crowd","body":"Wednesday bingo has outgrown the church basement and will move to the grange hall. The caller has been given a microphone and a warning about volume.","priority":0.0,"filler":true},{"kind":"","headline":"Motel Pool Refilled; Children Appear From Nowhere","body":"The motel pool was refilled for the season, and within an hour it held more children than the town has on record. The manager has stopped asking for room numbers.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"February 1921","year":1921.0,"month":2.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1921 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Diner Adds Second Fan; Customers Weep With Gratitude","body":"The diner on Main Street has installed a second ceiling fan. Regulars describe the difference as life-changing. The pie is unchanged.","priority":0.0,"filler":true},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"March 1921","year":1921.0,"month":3.0,"day":22.0,"extra":false,"stories":[{"kind":"approval_vote","headline":"Town Hall Straw Poll Delivers A Verdict","body":"The annual approval poll put Mayor Sierra at 46 percent this year. The top complaint, as ever, was whatever residents had waited longest for.\n\nThe mayor's office said the number speaks for itself. Everyone else said it too, meaning different things.","priority":500.0,"filler":false},{"kind":"tourism_event_announced","headline":"Mark The Calendar: Annual Carnival Comes In April 1921","body":"Bonanza Gap has announced Annual Carnival for April 1921. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Tumbleweed The Size Of A Truck Rolls Through Downtown","body":"A tumbleweed of unusual size crossed downtown on Sunday, paused at a stop sign, and continued east. Witnesses agree it had the right of way.","priority":0.0,"filler":true},{"kind":"","headline":"Annual Chili Cook-Off Won By Same Man For Ninth Year","body":"The chili cook-off was won again by the same fellow with the same recipe, which he will not share. Second place was awarded to a pot that a judge described as brave.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"April 1921","year":1921.0,"month":4.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1921 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Town Clock Repaired; Runs Fast Out Of Enthusiasm","body":"The courthouse clock has been repaired and now gains a minute a day. The clockmaker says it will settle down once it gets used to the heat.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true},{"kind":"","headline":"Casino Opens With Free Peanuts, Paid Everything Else","body":"A new casino opened on the strip with a brass band, a searchlight and a buffet that ran out by nine. Management called the evening a success. Patrons called it Tuesday.","priority":0.0,"filler":true},{"kind":"","headline":"Well-Digging Contest Ends In Draw, Mud","body":"The well-digging contest at the fair ended when both teams struck water at the same moment and then each other. No winner was declared, but everyone was clean for once.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"May 1921","year":1921.0,"month":5.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Commuters Spend Lunch Hour Stuck Near Bonanza Gap","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"","headline":"Jackrabbit Population Booms; Gardeners Despair","body":"A wet spring has produced more jackrabbits than anyone can count, and they are eating everything green within city limits. One resident has begun naming them, which is not a solution.","priority":0.0,"filler":true},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Drive-In Reopens With Double Feature And Single Speaker","body":"The drive-in screened its first films in years to a full lot. The one working speaker was placed in the middle and people parked around it like a campfire.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"June 1921","year":1921.0,"month":6.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1921 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Giant Fiberglass Cactus Draws Visitors, Confuses Birds","body":"The roadside cactus on the highway into town is now the tallest thing for miles. Motorists stop for photographs and birds stop to be disappointed.","priority":0.0,"filler":true},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"July 1921","year":1921.0,"month":7.0,"day":22.0,"extra":false,"stories":[{"kind":"advisor_need","headline":"Transport: The Word From The Advisors' Office","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Drive-In Reopens With Double Feature And Single Speaker","body":"The drive-in screened its first films in years to a full lot. The one working speaker was placed in the middle and people parked around it like a campfire.","priority":0.0,"filler":true},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Local Man Claims To Have Seen Rain; Others Skeptical","body":"A resident reports seeing rain fall on the north end of town. Nobody else saw it, the ground was dry by the time anyone looked, and the matter has been referred to the weather office.","priority":0.0,"filler":true},{"kind":"","headline":"Fishing Derby Held At Reservoir; Fish Decline To Participate","body":"The fishing derby went ahead despite the fish, who kept to the deep end. The prize for largest catch went to a hat.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"August 1921","year":1921.0,"month":8.0,"day":22.0,"extra":false,"stories":[{"kind":"tourism_event_announced","headline":"City Sports Festival Scheduled For September 1921","body":"Bonanza Gap has announced City Sports Festival for September 1921. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Annual Chili Cook-Off Won By Same Man For Ninth Year","body":"The chili cook-off was won again by the same fellow with the same recipe, which he will not share. Second place was awarded to a pot that a judge described as brave.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Scorpion Found In Boot; Boot Found In Yard","body":"A resident discovered a scorpion in his boot on Monday morning. The boot was last seen traveling at speed across the lawn. Both are recovering.","priority":0.0,"filler":true},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"September 1921","year":1921.0,"month":9.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Wind Blows, Sun Sets, Bonanza Gap Carries On","body":"By every measure the Dispatch keeps, 1921 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Drive-In Reopens With Double Feature And Single Speaker","body":"The drive-in screened its first films in years to a full lot. The one working speaker was placed in the middle and people parked around it like a campfire.","priority":0.0,"filler":true},{"kind":"","headline":"Mayor Sierra Cuts Ribbon; Scissors Also Cut Mayor","body":"The ribbon-cutting at the new bench went ahead with a minor injury to Mayor Sierra, who described the scissors as sharper than expected. The bench is open.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true},{"kind":"","headline":"Old-Timers Bench Gets New Slat; Old-Timers Suspicious","body":"The bench outside the courthouse has a new slat. Its regular occupants tested it for an afternoon and concluded that it will do, for now.","priority":0.0,"filler":true},{"kind":"","headline":"Scorpion Found In Boot; Boot Found In Yard","body":"A resident discovered a scorpion in his boot on Monday morning. The boot was last seen traveling at speed across the lawn. Both are recovering.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"October 1921","year":1921.0,"month":10.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1921 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Old Mine Shaft Fenced Off After Goat Incident","body":"The mine shaft east of town has been fenced after a goat was retrieved from it for the third time. The goat is fine and appears to enjoy the attention.","priority":0.0,"filler":true},{"kind":"","headline":"Fishing Derby Held At Reservoir; Fish Decline To Participate","body":"The fishing derby went ahead despite the fish, who kept to the deep end. The prize for largest catch went to a hat.","priority":0.0,"filler":true},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"Dust Storm Sandblasts Every Windshield In Town","body":"A wall of dust rolled through on Thursday and left every car in Bonanza Gap the same shade of tan. The car wash is booked for a month.","priority":0.0,"filler":true},{"kind":"","headline":"Local Man Claims To Have Seen Rain; Others Skeptical","body":"A resident reports seeing rain fall on the north end of town. Nobody else saw it, the ground was dry by the time anyone looked, and the matter has been referred to the weather office.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"November 1921","year":1921.0,"month":11.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"A Quiet Month In Bonanza Gap","body":"By every measure the Dispatch keeps, 1921 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Water Tower Repainted; Town Name Spelled Right This Time","body":"The water tower received a fresh coat of paint and, after some discussion, the correct spelling of Bonanza Gap. The painter blamed the wind for last time.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"December 1921","year":1921.0,"month":12.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Gridlock Grips Bonanza Gap","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Casino Opens With Free Peanuts, Paid Everything Else","body":"A new casino opened on the strip with a brass band, a searchlight and a buffet that ran out by nine. Management called the evening a success. Patrons called it Tuesday.","priority":0.0,"filler":true},{"kind":"","headline":"Local Man Claims To Have Seen Rain; Others Skeptical","body":"A resident reports seeing rain fall on the north end of town. Nobody else saw it, the ground was dry by the time anyone looked, and the matter has been referred to the weather office.","priority":0.0,"filler":true},{"kind":"","headline":"Rodeo Weekend Leaves Town Sore But Happy","body":"Rodeo weekend came and went with the usual mix of bruises, dust and sunburn. The bull, which has a name, was declared the winner again.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"January 1922","year":1922.0,"month":1.0,"day":22.0,"extra":false,"stories":[{"kind":"neighbor_news","headline":"Amargosa Sends Regards And A Trade Proposal","body":"Word arrived from Amargosa, our neighbor down the highway, of growth and ambition over there. Their population and ours now trade back and forth across the line.\n\nRelations remain cordial. Their football team is another matter.","priority":200.0,"filler":false},{"kind":"advisor_need","headline":"Council Told Transport Can't Wait","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Giant Fiberglass Cactus Draws Visitors, Confuses Birds","body":"The roadside cactus on the highway into town is now the tallest thing for miles. Motorists stop for photographs and birds stop to be disappointed.","priority":0.0,"filler":true},{"kind":"","headline":"Cactus Blooms Overnight; Town Turns Out To Look","body":"The night-blooming cactus outside the library opened at last, and half of Bonanza Gap stood around it in bathrobes. It closed by morning, as is its habit.","priority":0.0,"filler":true},{"kind":"","headline":"Dust Storm Sandblasts Every Windshield In Town","body":"A wall of dust rolled through on Thursday and left every car in Bonanza Gap the same shade of tan. The car wash is booked for a month.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"February 1922","year":1922.0,"month":2.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Wind Blows, Sun Sets, Bonanza Gap Carries On","body":"By every measure the Dispatch keeps, 1922 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Casino Opens With Free Peanuts, Paid Everything Else","body":"A new casino opened on the strip with a brass band, a searchlight and a buffet that ran out by nine. Management called the evening a success. Patrons called it Tuesday.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Gas Station Adds Ice Machine; Traffic Jam Follows","body":"The gas station at the edge of town installed an ice machine and immediately caused the largest traffic jam in Bonanza Gap history. Police describe the crowd as orderly and damp.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"March 1922","year":1922.0,"month":3.0,"day":22.0,"extra":false,"stories":[{"kind":"approval_vote","headline":"Approval Stands At 37 Percent After March Count","body":"The annual approval poll put Mayor Sierra at 37 percent this year. The top complaint, as ever, was whatever residents had waited longest for.\n\nThe mayor's office said the number speaks for itself. Everyone else said it too, meaning different things.","priority":500.0,"filler":false},{"kind":"tourism_event_announced","headline":"Annual Carnival Scheduled For April 1922","body":"Bonanza Gap has announced Annual Carnival for April 1922. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Bingo Night Moved To Larger Hall After Standing-Room Crowd","body":"Wednesday bingo has outgrown the church basement and will move to the grange hall. The caller has been given a microphone and a warning about volume.","priority":0.0,"filler":true},{"kind":"","headline":"Old-Timers Bench Gets New Slat; Old-Timers Suspicious","body":"The bench outside the courthouse has a new slat. Its regular occupants tested it for an afternoon and concluded that it will do, for now.","priority":0.0,"filler":true},{"kind":"","headline":"Chili Cook-Off Judge Recovers; Vows To Return","body":"The judge hospitalized after last month's cook-off has recovered and says he will be back next year. His doctor has other views.","priority":0.0,"filler":true},{"kind":"","headline":"Old Mine Shaft Fenced Off After Goat Incident","body":"The mine shaft east of town has been fenced after a goat was retrieved from it for the third time. The goat is fine and appears to enjoy the attention.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"April 1922","year":1922.0,"month":4.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1922 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Mayor Sierra Cuts Ribbon; Scissors Also Cut Mayor","body":"The ribbon-cutting at the new bench went ahead with a minor injury to Mayor Sierra, who described the scissors as sharper than expected. The bench is open.","priority":0.0,"filler":true},{"kind":"","headline":"Fishing Derby Held At Reservoir; Fish Decline To Participate","body":"The fishing derby went ahead despite the fish, who kept to the deep end. The prize for largest catch went to a hat.","priority":0.0,"filler":true},{"kind":"","headline":"Giant Fiberglass Cactus Draws Visitors, Confuses Birds","body":"The roadside cactus on the highway into town is now the tallest thing for miles. Motorists stop for photographs and birds stop to be disappointed.","priority":0.0,"filler":true},{"kind":"","headline":"Chili Cook-Off Judge Recovers; Vows To Return","body":"The judge hospitalized after last month's cook-off has recovered and says he will be back next year. His doctor has other views.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"May 1922","year":1922.0,"month":5.0,"day":22.0,"extra":false,"stories":[{"kind":"casino_windfall","headline":"City Hall Breaks The Bank At Boulder Crown","body":"Mayor Sierra walked away from Boulder Crown this month with $50,000 more in the city's treasury than went in. The pit boss described the run as statistically unlikely and personally hurtful.\n\nThe budget office has booked the winnings and urged the mayor to stop while ahead. The mayor's office did not say whether that advice was taken.","priority":360.0,"filler":false},{"kind":"neighbor_news","headline":"News From Down The Road: Jean Dry Lake Grows","body":"Word arrived from Jean Dry Lake, our neighbor down the highway, of growth and ambition over there. Their population and ours now trade back and forth across the line.\n\nRelations remain cordial. Their football team is another matter.","priority":200.0,"filler":false},{"kind":"","headline":"Motel Pool Refilled; Children Appear From Nowhere","body":"The motel pool was refilled for the season, and within an hour it held more children than the town has on record. The manager has stopped asking for room numbers.","priority":0.0,"filler":true},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"High School Team Wins By Forfeit; Other Team Lost In Desert","body":"The visiting team took a wrong turn on the way to Friday's game and was found by a rancher some hours later. The home side has claimed the win and a photograph of the tumbleweed they blame.","priority":0.0,"filler":true},{"kind":"","headline":"Bingo Night Moved To Larger Hall After Standing-Room Crowd","body":"Wednesday bingo has outgrown the church basement and will move to the grange hall. The caller has been given a microphone and a warning about volume.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"June 1922","year":1922.0,"month":6.0,"day":22.0,"extra":false,"stories":[{"kind":"abandonment_wave","headline":"Boarded Windows Multiply Near Bonanza Gap","body":"Another 9 buildings around Bonanza Gap were left empty this month. Owners cite a mix of taxes, traffic, crime and the general feeling that the grass is greener anywhere with grass.\n\nThe council was asked what it intends to do. Mayor Sierra said the matter was under review, which is what mayors say.","priority":360.0,"filler":false},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"Town Clock Repaired; Runs Fast Out Of Enthusiasm","body":"The courthouse clock has been repaired and now gains a minute a day. The clockmaker says it will settle down once it gets used to the heat.","priority":0.0,"filler":true},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"July 1922","year":1922.0,"month":7.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Gridlock Grips Bonanza Gap","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"advisor_need","headline":"Council Told Transport Can't Wait","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Bingo Night Moved To Larger Hall After Standing-Room Crowd","body":"Wednesday bingo has outgrown the church basement and will move to the grange hall. The caller has been given a microphone and a warning about volume.","priority":0.0,"filler":true},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"Tumbleweed The Size Of A Truck Rolls Through Downtown","body":"A tumbleweed of unusual size crossed downtown on Sunday, paused at a stop sign, and continued east. Witnesses agree it had the right of way.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"August 1922","year":1922.0,"month":8.0,"day":22.0,"extra":false,"stories":[{"kind":"tourism_event_announced","headline":"City Sports Festival Scheduled For September 1922","body":"Bonanza Gap has announced City Sports Festival for September 1922. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Bingo Night Moved To Larger Hall After Standing-Room Crowd","body":"Wednesday bingo has outgrown the church basement and will move to the grange hall. The caller has been given a microphone and a warning about volume.","priority":0.0,"filler":true},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Jackrabbit Population Booms; Gardeners Despair","body":"A wet spring has produced more jackrabbits than anyone can count, and they are eating everything green within city limits. One resident has begun naming them, which is not a solution.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"September 1922","year":1922.0,"month":9.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"A Quiet Month In Bonanza Gap","body":"By every measure the Dispatch keeps, 1922 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"October 1922","year":1922.0,"month":10.0,"day":22.0,"extra":false,"stories":[{"kind":"abandonment_wave","headline":"Boarded Windows Multiply Near Bonanza Gap","body":"Another 8 buildings around Bonanza Gap were left empty this month. Owners cite a mix of taxes, traffic, crime and the general feeling that the grass is greener anywhere with grass.\n\nThe council was asked what it intends to do. Mayor Sierra said the matter was under review, which is what mayors say.","priority":360.0,"filler":false},{"kind":"","headline":"Water Tower Repainted; Town Name Spelled Right This Time","body":"The water tower received a fresh coat of paint and, after some discussion, the correct spelling of Bonanza Gap. The painter blamed the wind for last time.","priority":0.0,"filler":true},{"kind":"","headline":"Diner Adds Second Fan; Customers Weep With Gratitude","body":"The diner on Main Street has installed a second ceiling fan. Regulars describe the difference as life-changing. The pie is unchanged.","priority":0.0,"filler":true},{"kind":"","headline":"Annual Chili Cook-Off Won By Same Man For Ninth Year","body":"The chili cook-off was won again by the same fellow with the same recipe, which he will not share. Second place was awarded to a pot that a judge described as brave.","priority":0.0,"filler":true},{"kind":"","headline":"Swap Meet Trades Same Lamp For Fifth Year Running","body":"A brass lamp changed hands again at the swap meet and is now believed to have lived in every house on the west side. Its current owner intends to keep it, which nobody believes.","priority":0.0,"filler":true},{"kind":"","headline":"Chili Cook-Off Judge Recovers; Vows To Return","body":"The judge hospitalized after last month's cook-off has recovered and says he will be back next year. His doctor has other views.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"November 1922","year":1922.0,"month":11.0,"day":22.0,"extra":false,"stories":[{"kind":"neighbor_news","headline":"Tonopah Wells Sends Regards And A Trade Proposal","body":"Word arrived from Tonopah Wells, our neighbor down the highway, of growth and ambition over there. Their population and ours now trade back and forth across the line.\n\nRelations remain cordial. Their football team is another matter.","priority":200.0,"filler":false},{"kind":"","headline":"Barbershop Quartet Now A Trio; Tenor Moved To The Coast","body":"The town quartet has lost its tenor to a job on the coast. Auditions are open. Applicants are warned that the repertoire is mostly about trains.","priority":0.0,"filler":true},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"Swap Meet Trades Same Lamp For Fifth Year Running","body":"A brass lamp changed hands again at the swap meet and is now believed to have lived in every house on the west side. Its current owner intends to keep it, which nobody believes.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"December 1922","year":1922.0,"month":12.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Wind Blows, Sun Sets, Bonanza Gap Carries On","body":"By every measure the Dispatch keeps, 1922 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Diner Adds Second Fan; Customers Weep With Gratitude","body":"The diner on Main Street has installed a second ceiling fan. Regulars describe the difference as life-changing. The pie is unchanged.","priority":0.0,"filler":true},{"kind":"","headline":"Motel Pool Refilled; Children Appear From Nowhere","body":"The motel pool was refilled for the season, and within an hour it held more children than the town has on record. The manager has stopped asking for room numbers.","priority":0.0,"filler":true},{"kind":"","headline":"High School Team Wins By Forfeit; Other Team Lost In Desert","body":"The visiting team took a wrong turn on the way to Friday's game and was found by a rancher some hours later. The home side has claimed the win and a photograph of the tumbleweed they blame.","priority":0.0,"filler":true},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Water Tower Repainted; Town Name Spelled Right This Time","body":"The water tower received a fresh coat of paint and, after some discussion, the correct spelling of Bonanza Gap. The painter blamed the wind for last time.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"January 1923","year":1923.0,"month":1.0,"day":22.0,"extra":false,"stories":[{"kind":"neighbor_news","headline":"News From Down The Road: Amargosa Grows","body":"Word arrived from Amargosa, our neighbor down the highway, of growth and ambition over there. Their population and ours now trade back and forth across the line.\n\nRelations remain cordial. Their football team is another matter.","priority":200.0,"filler":false},{"kind":"advisor_need","headline":"Advisors Press Council On Transport","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Old-Timers Bench Gets New Slat; Old-Timers Suspicious","body":"The bench outside the courthouse has a new slat. Its regular occupants tested it for an afternoon and concluded that it will do, for now.","priority":0.0,"filler":true},{"kind":"","headline":"Town Clock Repaired; Runs Fast Out Of Enthusiasm","body":"The courthouse clock has been repaired and now gains a minute a day. The clockmaker says it will settle down once it gets used to the heat.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"February 1923","year":1923.0,"month":2.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Gridlock Grips Bonanza Gap","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true},{"kind":"","headline":"Neon Sign Repaired; Now Reads Correctly For First Time In Years","body":"The motel sign that has read MOT L since anyone can remember has been fixed. Longtime residents say it looks wrong.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"March 1923","year":1923.0,"month":3.0,"day":22.0,"extra":false,"stories":[{"kind":"approval_vote","headline":"Approval Stands At 36 Percent After March Count","body":"The annual approval poll put Mayor Sierra at 36 percent this year. The top complaint, as ever, was whatever residents had waited longest for.\n\nThe mayor's office said the number speaks for itself. Everyone else said it too, meaning different things.","priority":500.0,"filler":false},{"kind":"tourism_event_announced","headline":"Mark The Calendar: Annual Carnival Comes In April 1923","body":"Bonanza Gap has announced Annual Carnival for April 1923. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Annual Chili Cook-Off Won By Same Man For Ninth Year","body":"The chili cook-off was won again by the same fellow with the same recipe, which he will not share. Second place was awarded to a pot that a judge described as brave.","priority":0.0,"filler":true},{"kind":"","headline":"Diner Adds Second Fan; Customers Weep With Gratitude","body":"The diner on Main Street has installed a second ceiling fan. Regulars describe the difference as life-changing. The pie is unchanged.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"April 1923","year":1923.0,"month":4.0,"day":22.0,"extra":false,"stories":[{"kind":"economy_shift","headline":"Outlook Shifts To Growth For The Region","body":"The national outlook has shifted to Growth, according to the people paid to say such things. Local factories and shops will feel it over the coming months.\n\nThe chamber of commerce urged calm, then quietly checked its savings.","priority":500.0,"filler":false},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Scorpion Found In Boot; Boot Found In Yard","body":"A resident discovered a scorpion in his boot on Monday morning. The boot was last seen traveling at speed across the lawn. Both are recovering.","priority":0.0,"filler":true},{"kind":"","headline":"Annual Chili Cook-Off Won By Same Man For Ninth Year","body":"The chili cook-off was won again by the same fellow with the same recipe, which he will not share. Second place was awarded to a pot that a judge described as brave.","priority":0.0,"filler":true},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"May 1923","year":1923.0,"month":5.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Slow News Month Declared Official","body":"By every measure the Dispatch keeps, 1923 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Cactus Blooms Overnight; Town Turns Out To Look","body":"The night-blooming cactus outside the library opened at last, and half of Bonanza Gap stood around it in bathrobes. It closed by morning, as is its habit.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Neon Sign Repaired; Now Reads Correctly For First Time In Years","body":"The motel sign that has read MOT L since anyone can remember has been fixed. Longtime residents say it looks wrong.","priority":0.0,"filler":true},{"kind":"","headline":"Windmill Squeak Finally Oiled; Town Can't Sleep Without It","body":"The windmill by the stockyard has been oiled after years of squeaking. Several residents report insomnia and have asked for it to be put back the way it was.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"June 1923","year":1923.0,"month":6.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1923 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Annual Chili Cook-Off Won By Same Man For Ninth Year","body":"The chili cook-off was won again by the same fellow with the same recipe, which he will not share. Second place was awarded to a pot that a judge described as brave.","priority":0.0,"filler":true},{"kind":"","headline":"Dust Storm Sandblasts Every Windshield In Town","body":"A wall of dust rolled through on Thursday and left every car in Bonanza Gap the same shade of tan. The car wash is booked for a month.","priority":0.0,"filler":true},{"kind":"","headline":"Rodeo Weekend Leaves Town Sore But Happy","body":"Rodeo weekend came and went with the usual mix of bruises, dust and sunburn. The bull, which has a name, was declared the winner again.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"July 1923","year":1923.0,"month":7.0,"day":22.0,"extra":false,"stories":[{"kind":"advisor_need","headline":"Advisors Press Council On Transport","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Rodeo Weekend Leaves Town Sore But Happy","body":"Rodeo weekend came and went with the usual mix of bruises, dust and sunburn. The bull, which has a name, was declared the winner again.","priority":0.0,"filler":true},{"kind":"","headline":"Scorpion Found In Boot; Boot Found In Yard","body":"A resident discovered a scorpion in his boot on Monday morning. The boot was last seen traveling at speed across the lawn. Both are recovering.","priority":0.0,"filler":true},{"kind":"","headline":"Jackrabbit Population Booms; Gardeners Despair","body":"A wet spring has produced more jackrabbits than anyone can count, and they are eating everything green within city limits. One resident has begun naming them, which is not a solution.","priority":0.0,"filler":true},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true},{"kind":"","headline":"Coyotes Serenade East Side For Third Straight Night","body":"Residents of the east side report three nights of coyote song. Opinions are divided on the harmonies but not on the volume.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"August 1923","year":1923.0,"month":8.0,"day":22.0,"extra":false,"stories":[{"kind":"tourism_event_announced","headline":"Bonanza Gap Books City Sports Festival For September 1923","body":"Bonanza Gap has announced City Sports Festival for September 1923. Eligible visitor markets receive a seasonal event boost, subject to available transport, staff, beds, power and water.\n\nOrganizers warned that the event will be cancelled if its qualifying services are lost before the big day. Hotel managers were already counting rooms.","priority":500.0,"filler":false},{"kind":"","headline":"Stray Burro Adopted By Fire Station","body":"A burro that wandered into the fire station has been adopted by the crew. It answers to Chief and has already been photographed in a helmet.","priority":0.0,"filler":true},{"kind":"","headline":"Local Man Claims To Have Seen Rain; Others Skeptical","body":"A resident reports seeing rain fall on the north end of town. Nobody else saw it, the ground was dry by the time anyone looked, and the matter has been referred to the weather office.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Radio Station Adds Second Record","body":"The local station has acquired a second record and will alternate it with the first. Listeners are advised that the second one is a waltz.","priority":0.0,"filler":true},{"kind":"","headline":"Dust Storm Sandblasts Every Windshield In Town","body":"A wall of dust rolled through on Thursday and left every car in Bonanza Gap the same shade of tan. The car wash is booked for a month.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"September 1923","year":1923.0,"month":9.0,"day":22.0,"extra":false,"stories":[{"kind":"traffic_jam","headline":"Bonanza Gap Drivers Learn Every Word Of The Radio Jingle","body":"Traffic around Bonanza Gap reached a standstill this month. One motorist reported finishing a paperback between two intersections.\n\nEngineers suggest more roads, better rail, or fewer people driving to the same place at the same time. The council prefers the option that costs nothing, which does not exist.","priority":500.0,"filler":false},{"kind":"abandonment_wave","headline":"8 Buildings Stand Empty As Tenants Move On","body":"Another 8 buildings around Bonanza Gap were left empty this month. Owners cite a mix of taxes, traffic, crime and the general feeling that the grass is greener anywhere with grass.\n\nThe council was asked what it intends to do. Mayor Sierra said the matter was under review, which is what mayors say.","priority":360.0,"filler":false},{"kind":"","headline":"Farmers' Market Opens; Mostly Melons, Mostly Fine","body":"The Saturday market opened for the season with a strong showing of melons and one table of jam. Attendance was high, as was the temperature.","priority":0.0,"filler":true},{"kind":"","headline":"Chili Cook-Off Judge Recovers; Vows To Return","body":"The judge hospitalized after last month's cook-off has recovered and says he will be back next year. His doctor has other views.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"October 1923","year":1923.0,"month":10.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Wind Blows, Sun Sets, Bonanza Gap Carries On","body":"By every measure the Dispatch keeps, 1923 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Swap Meet Trades Same Lamp For Fifth Year Running","body":"A brass lamp changed hands again at the swap meet and is now believed to have lived in every house on the west side. Its current owner intends to keep it, which nobody believes.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true},{"kind":"","headline":"Retired Prospector Finds Nothing, Reports Good Day","body":"A retired prospector returned from the hills with an empty sack and a broad smile. Asked what he found, he said quiet, and recommended it.","priority":0.0,"filler":true},{"kind":"","headline":"Drive-In Reopens With Double Feature And Single Speaker","body":"The drive-in screened its first films in years to a full lot. The one working speaker was placed in the middle and people parked around it like a campfire.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"November 1923","year":1923.0,"month":11.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Dispatch Editor Considers Fishing Trip","body":"By every measure the Dispatch keeps, 1923 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true},{"kind":"","headline":"Petrified Log Returned To Roadside Attraction After Forty Years","body":"A petrified log taken from the roadside attraction decades ago arrived by post with an apology. The attraction has put it back and framed the letter.","priority":0.0,"filler":true},{"kind":"","headline":"Mineral Springs Water Now Bottled; Tastes Like Nickels","body":"A local outfit has begun bottling the mineral springs water. The label promises vitality. The taste promises pocket change.","priority":0.0,"filler":true},{"kind":"","headline":"Hardware Store Sells Out Of Shade Cloth In One Afternoon","body":"A shipment of shade cloth lasted about four hours at the hardware store on Saturday. The owner has ordered more and a rope for the queue.","priority":0.0,"filler":true},{"kind":"","headline":"Giant Fiberglass Cactus Draws Visitors, Confuses Birds","body":"The roadside cactus on the highway into town is now the tallest thing for miles. Motorists stop for photographs and birds stop to be disappointed.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"December 1923","year":1923.0,"month":12.0,"day":22.0,"extra":false,"stories":[{"kind":"quiet_month","headline":"Wind Blows, Sun Sets, Bonanza Gap Carries On","body":"By every measure the Dispatch keeps, 1923 in Bonanza Gap continued at its usual pace this month. No sirens, no speeches, and the dust settled where it fell.\n\nOld-timers on the courthouse bench called it the best kind of news. The editor, who has a page to fill, disagreed but was outvoted.","priority":0.0,"filler":false},{"kind":"","headline":"Dust Storm Sandblasts Every Windshield In Town","body":"A wall of dust rolled through on Thursday and left every car in Bonanza Gap the same shade of tan. The car wash is booked for a month.","priority":0.0,"filler":true},{"kind":"","headline":"Well-Digging Contest Ends In Draw, Mud","body":"The well-digging contest at the fair ended when both teams struck water at the same moment and then each other. No winner was declared, but everyone was clean for once.","priority":0.0,"filler":true},{"kind":"","headline":"Heat Wave Enters Third Week; Sidewalks Fry Eggs, Reporters Confirm","body":"Temperatures held above anything reasonable for a third week. The Dispatch tested the sidewalk-egg theory and can report that it works, if you like your eggs with grit.","priority":0.0,"filler":true},{"kind":"","headline":"Rodeo Weekend Leaves Town Sore But Happy","body":"Rodeo weekend came and went with the usual mix of bruises, dust and sunburn. The bull, which has a name, was declared the winner again.","priority":0.0,"filler":true},{"kind":"","headline":"Mayor Sierra Cuts Ribbon; Scissors Also Cut Mayor","body":"The ribbon-cutting at the new bench went ahead with a minor injury to Mayor Sierra, who described the scissors as sharper than expected. The bench is open.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"January 1924","year":1924.0,"month":1.0,"day":22.0,"extra":false,"stories":[{"kind":"neighbor_news","headline":"Jean Dry Lake Sends Regards And A Trade Proposal","body":"Word arrived from Jean Dry Lake, our neighbor down the highway, of growth and ambition over there. Their population and ours now trade back and forth across the line.\n\nRelations remain cordial. Their football team is another matter.","priority":200.0,"filler":false},{"kind":"advisor_need","headline":"Council Told Transport Can't Wait","body":"The advisors' office delivered its monthly memorandum on Transport to Mayor Sierra. It was short, underlined, and left on top of the pile.\n\nThe mayor's office confirmed receipt. Residents confirmed the problem.","priority":200.0,"filler":false},{"kind":"","headline":"Tumbleweed The Size Of A Truck Rolls Through Downtown","body":"A tumbleweed of unusual size crossed downtown on Sunday, paused at a stop sign, and continued east. Witnesses agree it had the right of way.","priority":0.0,"filler":true},{"kind":"","headline":"Hot Springs Reopen; Smell Described As Character","body":"The hot springs south of town reopened after repairs. Visitors are reminded that the smell is natural, historic, and part of the experience.","priority":0.0,"filler":true},{"kind":"","headline":"Snow Falls On Bonanza Gap; Nobody Owns A Shovel","body":"A rare snowfall dusted Bonanza Gap overnight and was gone by lunch. In the interval, residents photographed it, tasted it, and looked for a shovel that does not exist.","priority":0.0,"filler":true},{"kind":"","headline":"Painted Rock On Hill Repainted; Now Also Wrong Color","body":"The big rock on the hill was repainted overnight by persons unknown. The council has decided that this year's color is the official one until someone changes it.","priority":0.0,"filler":true}]},{"title":"The Desert Dispatch","date":"February 1924","year":1924.0,"month":2.0,"day":22.0,"extra":false,"stories":[{"kind":"neighbor_growth","headline":"Growth Next Door In Tonopah Wells","body":"Our neighbor Tonopah Wells now counts more than 10,000 residents, and some of them work here. The highway between the towns is busier every month.\n\nThe Dispatch congratulates Tonopah Wells and reminds it who was here first.","priority":200.0,"filler":false},{"kind":"","headline":"Mystery Hum Traced To Refrigerator At The Feed Store","body":"The low hum that has puzzled the east side for a month has been traced to a refrigerator at the feed store. It has been switched off and the mystery is over, to general disappointment.","priority":0.0,"filler":true},{"kind":"","headline":"Well-Digging Contest Ends In Draw, Mud","body":"The well-digging contest at the fair ended when both teams struck water at the same moment and then each other. No winner was declared, but everyone was clean for once.","priority":0.0,"filler":true},{"kind":"","headline":"Sunset Declared Best Of The Year By Committee","body":"The sunset committee met on the ridge on Friday and declared this year's best. Minutes record it as orange with purple, which narrows it down somewhat.","priority":0.0,"filler":true},{"kind":"","headline":"Ghost Town Tour Canceled After Ghost Town Gets Residents","body":"The weekly tour of the abandoned settlement up the road has been called off, as three families have moved in and object to being photographed.","priority":0.0,"filler":true},{"kind":"","headline":"Lizard Races Return To The Fairgrounds","body":"The annual lizard races drew a full grandstand this year. The favorite refused to leave the starting line, which is understandable in this heat.","priority":0.0,"filler":true}]}]},"systems":{"power":{"shortage":false,"consumed":1456},"water":{"shortage":false,"consumed":1725,"treatment_adequate":false,"requested_demand":1730,"visitor_demand":79},"tourism":{"schema":3,"features":{"safety":{"period_month":289,"active":true,"cost_half_cents":4628,"remainders":[{"instance":1,"micro":360500,"cursor":4,"opening_micro":261500,"opening_cursor":4,"month":289},{"instance":5,"micro":859000,"cursor":39,"opening_micro":373000,"opening_cursor":39,"month":289},{"instance":6,"micro":614000,"cursor":28,"opening_micro":267500,"opening_cursor":28,"month":289},{"instance":82,"micro":536000,"cursor":4,"opening_micro":320000,"opening_cursor":4,"month":289},{"instance":10,"micro":850500,"cursor":9,"opening_micro":